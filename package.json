{
  "name": "sale-radar",
  "version": "0.1.0",
  "private": true,
  "description": "내 주변(100m~1km) 할인·1+1·타임세일·마감할인 행사를 모아 보여주는 위치 기반 앱",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "build:static": "npm run build:static -w client",
    "start": "npm run start -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "test": "vitest run",
    "import": "npm run import -w server --",
    "data:update": "npm run data:update -w server --",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
