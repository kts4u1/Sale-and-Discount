# ─────────────────────────────────────────────────────────────
# 세일레이더 서버 설정. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# 키가 하나도 없어도 앱은 동작합니다 (OpenStreetMap 매장 + 샘플 데이터).
# ─────────────────────────────────────────────────────────────

# 서버 포트
PORT=8787

# ── 실제 할인 데이터 ─────────────────────────────────────────
# 한국소비자원 참가격 (생필품 가격·할인·1+1) — 공공데이터포털 인증키
# https://www.data.go.kr/data/15158701/openapi.do 에서 "활용신청" 후 마이페이지의 인증키
# (Encoding / Decoding 키 어느 것을 넣어도 됩니다. 학원 앱과 같은 키입니다)
# 검색할 때마다 부르지 않고, 서버가 하루 한 번 전국 자료를 받아 둡니다.
# GitHub Pages 로 배포할 때는 이 파일 대신 저장소 Settings → Secrets → Actions 에 같은 이름으로 넣으세요.
DATA_GO_KR_KEY=

# 서버가 매일 자동으로 받을지, 받을 시각(한국 시간)
KCA_AUTO_UPDATE=true
KCA_UPDATE_TIME=06:10

# ── 매장·주소 정보 ──────────────────────────────────────────
# 카카오 로컬 REST API 키 — https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# (카카오맵 API 사용 설정을 켜야 합니다)
KAKAO_REST_API_KEY=

# 네이버 검색 API (매장 상세의 블로그 소식) — https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenStreetMap 매장 정보 사용 여부 (키 불필요)
ENABLE_OSM=true
# Overpass 서버 목록 (쉼표로 구분, 앞에서부터 시도)
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# ── 샘플 데이터 ─────────────────────────────────────────────
# auto: 참가격 키가 없으면 샘플을 기본으로 보여줌 / on: 항상 기본 표시 / off: 사용 안 함
SAMPLE_DATA=auto

# ── 기타 ────────────────────────────────────────────────────
# 데이터 저장 폴더 (사용자 제보, 캐시, 착한가격업소, 브랜드 행사)
# DATA_DIR=./server/data
# 리버스 프록시(nginx 등) 뒤에서 실행하면 true (요청 제한이 실제 IP 기준으로 동작)
TRUST_PROXY=false
# 지도 타일 (기본: OpenStreetMap). 사용자가 많으면 자체/상용 타일 서버로 바꾸세요.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# 외부 API 에 보내는 User-Agent (OpenStreetMap 정책상 연락처 포함 권장)
# USER_AGENT=SaleRadar/0.1 (you@example.com)
